{
  "info": {
    "name": "Reservas de habitaciones - API REST",
    "description": "Pruebas de la API del proyecto Reservas de habitaciones (Spring Boot + PostgreSQL).\n\nAntes de ejecutar: correr database/01_estructura.sql y database/02_datos_prueba.sql, e iniciar el backend en http://localhost:8080.\nEjecutar las carpetas en orden (1 a 4) o la colección completa con Run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fechas relativas a hoy para que la colección funcione cualquier día",
          "function sumarDias(dias) {",
          "    const f = new Date();",
          "    f.setDate(f.getDate() + dias);",
          "    return f.getFullYear() + '-' + String(f.getMonth() + 1).padStart(2, '0') + '-' + String(f.getDate()).padStart(2, '0');",
          "}",
          "pm.collectionVariables.set('ayer', sumarDias(-1));",
          "pm.collectionVariables.set('hoyMas1', sumarDias(1));",
          "pm.collectionVariables.set('hoyMas3', sumarDias(3));",
          "pm.collectionVariables.set('entradaPrueba', sumarDias(30));",
          "pm.collectionVariables.set('salidaPrueba', sumarDias(33));",
          "pm.collectionVariables.set('salidaPruebaModificada', sumarDias(34));"
        ]
      }
    }
  ],
